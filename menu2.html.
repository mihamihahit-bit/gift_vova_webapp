<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gift Vova App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: #10111a; color: white; padding-bottom: 70px; }
        
        /* Шапка */
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px; background: #10111a; position: sticky; top: 0; z-index: 10; }
        .logo { font-size: 20px; font-weight: 900; color: white; }
        .balance-chip { background: #1c1e2e; padding: 8px 12px; border-radius: 20px; font-weight: bold; }
        
        /* Вкладки (экраны) */
        .tab-content { display: none; padding: 15px; }
        .tab-content.active { display: block; }

        /* Главный экран игр */
        .banner { border-radius: 16px; background: linear-gradient(135deg, #2b1f5e, #121421); padding: 20px; border: 1px solid #382d7a; margin-bottom: 20px; }
        .banner h2 { font-size: 22px; margin-bottom: 5px; }
        .banner p { font-size: 12px; color: #b3b4c5; }
        .games-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .game-card { background: #1c1e2e; border-radius: 16px; padding: 15px; text-align: center; cursor: pointer; border: 1px solid #2a2e38; }
        .game-card.upg { background: linear-gradient(180deg, #5e1a1a, #1c1e2e); }
        .game-icon { font-size: 50px; margin: 10px 0; }
        .game-title { font-size: 16px; font-weight: bold; }

        /* Экран Апгрейда */
        #view-upgrade { display: none; }
        .upg-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .back-btn { background: #2a2e38; color: white; border: none; padding: 8px 15px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        
        /* Круглая шкала */
        .circle-wrap { position: relative; width: 180px; height: 180px; margin: 0 auto; border-radius: 50%; background: conic-gradient(#ff4b4b 0%, #ffdb4b 50%, #2a2e38 50%); display: flex; justify-content: center; align-items: center; box-shadow: 0 0 20px rgba(255, 75, 75, 0.2); transition: 0.3s; }
        .circle-inner { width: 150px; height: 150px; background: #10111a; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .chance-text { font-size: 24px; font-weight: bold; color: #ffdb4b; }
        .chance-sub { font-size: 12px; color: #8b8e96; }

        /* Слоты */
        .slots { display: flex; justify-content: space-between; align-items: center; margin: 25px 0; background: #171a21; padding: 15px; border-radius: 12px; border: 1px solid #2a2e38; }
        .slot { text-align: center; width: 45%; }
        .slot-item { font-size: 35px; background: #0f1115; padding: 10px; border-radius: 10px; border: 1px solid #2a2e38; }
        .slot-name { font-size: 11px; color: #8b8e96; margin-top: 5px; }
        .arrow { font-size: 20px; color: #ffdb4b; }

        /* Кнопки управления */
        .controls { display: flex; gap: 10px; margin-bottom: 10px; }
        .control-btn { flex: 1; background: #2a2e38; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; }
        .control-btn.active { background: #ffdb4b; color: black; }
        
        .action-btn { width: 100%; background: linear-gradient(90deg, #ff4b4b, #ffdb4b); color: black; border: none; padding: 15px; border-radius: 12px; font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 10px; }

        /* Нижнее меню */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; background-color: #171a21; display: flex; justify-content: space-around; padding: 12px 0; border-top: 1px solid #2a2e38; z-index: 20; }
        .nav-item { text-align: center; color: #8b8e96; font-size: 11px; font-weight: bold; cursor: pointer; }
        .nav-item.active { color: #a279f9; }
        .nav-icon { font-size: 18px; margin-bottom: 3px; }
    </style>
</head>
<body>
    
    <div class="header">
        <div class="logo">Gift Vova</div>
        <div class="balance-chip">💰 <span id="balanceDisplay">137382</span></div>
    </div>

    <!-- ЭКРАН 1: ИГРЫ И АПГРЕЙД -->
    <div id="tab-games" class="tab-content active">
        <div id="view-games-list">
            <div class="banner">
                <h2>Подарок</h2>
                <p>за пополнение баланса</p>
            </div>
            <div class="games-grid">
                <div class="game-card upg" onclick="openUpgrade()">
                    <div class="game-icon">🏛️</div>
                    <div class="game-title">Апгрейд</div>
                </div>
                <div class="game-card" onclick="tg.showAlert('Скоро!')">
                    <div class="game-icon">💎</div>
                    <div class="game-title">Шторм</div>
                </div>
                <div class="game-card" onclick="tg.showAlert('Скоро!')">
                    <div class="game-icon">🐮</div>
                    <div class="game-title">Кейсы</div>
                </div>
                <div class="game-card" onclick="tg.showAlert('Скоро!')">
                    <div class="game-icon">⚔️</div>
                    <div class="game-title">PvP</div>
                </div>
            </div>
        </div>

        <!-- Экран Апгрейда -->
        <div id="view-upgrade">
            <div class="upg-header">
                <button class="back-btn" onclick="closeUpgrade()">⬅️ Назад</button>
                <div style="font-weight: bold;">Апгрейдер</div>
            </div>

            <div class="circle-wrap" id="circle">
                <div class="circle-inner">
                    <div class="chance-text" id="chanceText">50%</div>
                    <div class="chance-sub">Шанс</div>
                </div>
            </div>

            <div class="slots">
                <div class="slot">
                    <div class="slot-item">🐮</div>
                    <div class="slot-name">NFT Корова</div>
                </div>
                <div class="arrow">➡️</div>
                <div class="slot">
                    <div class="slot-item">🐉</div>
                    <div class="slot-name">NFT Дракон</div>
                </div>
            </div>

            <div class="controls">
                <button class="control-btn active" onclick="setMultiplier(2, this)">x2</button>
                <button class="control-btn" onclick="setMultiplier(3, this)">x3</button>
                <button class="control-btn" onclick="setMultiplier(4, this)">x4</button>
            </div>

            <div class="controls">
                <button class="control-btn active" onclick="setChance(50, this)">50%</button>
                <button class="control-btn" onclick="setChance(70, this)">70%</button>
                <button class="control-btn" onclick="setChance(80, this)">80%</button>
            </div>

            <button class="action-btn" onclick="doUpgrade()">Прокачать</button>
        </div>
    </div>

    <!-- ЭКРАН 2: МАГАЗИН (Заглушка) -->
    <div id="tab-shop" class="tab-content">
        <h2 style="text-align: center; margin-top: 50px; color: #8b8e96;">Магазин в разработке...</h2>
    </div>

    <!-- ЭКРАН 3: ПРОФИЛЬ (Заглушка) -->
    <div id="tab-profile" class="tab-content">
        <h2 style="text-align: center; margin-top: 50px; color: #8b8e96;">Профиль в разработке...</h2>
    </div>

    <!-- НИЖНЕЕ МЕНЮ -->
    <div class="bottom-nav">
        <div class="nav-item active" onclick="switchTab('games', this)"><div class="nav-icon">🎮</div>Игры</div>
        <div class="nav-item" onclick="switchTab('shop', this)"><div class="nav-icon">🛒</div>Магазин</div>
        <div class="nav-item" onclick="switchTab('profile', this)"><div class="nav-icon">👤</div>Профиль</div>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        
        let currentMultiplier = 2;
        let currentChance = 50;

        // Переключение вкладок (Игры / Магазин / Профиль)
        function switchTab(tabName, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById(`tab-${tabName}`).classList.add('active');
            
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');

            if (tabName === 'games') closeUpgrade();
        }

        // Открытие и закрытие экрана Апгрейда
        function openUpgrade() {
            document.getElementById('view-games-list').style.display = 'none';
            document.getElementById('view-upgrade').style.display = 'block';
        }

        function closeUpgrade() {
            document.getElementById('view-upgrade').style.display = 'none';
            document.getElementById('view-games-list').style.display = 'block';
        }

        // Логика рулетки
        function setMultiplier(mult, btn) {
            currentMultiplier = mult;
            document.querySelectorAll('.control-btn').forEach(b => {
                if (b.innerText.includes('x')) b.classList.remove('active');
            });
            btn.classList.add('active');
        }

        function setChance(chance, btn) {
            currentChance = chance;
            document.querySelectorAll('.control-btn').forEach(b => {
                if (b.innerText.includes('%')) b.classList.remove('active');
            });
            btn.classList.add('active');
            
            const circle = document.getElementById('circle');
            circle.style.background = `conic-gradient(#ff4b4b 0%, #ffdb4b ${chance}%, #2a2e38 ${chance}%)`;
            document.getElementById('chanceText').innerText = `${chance}%`;
        }

        function doUpgrade() {
            document.getElementById('chanceText').innerText = "Крутим...";
            
            setTimeout(() => {
                document.getElementById('chanceText').innerText = `${currentChance}%`;
                const win = Math.random() * 100 < currentChance;
                
                if (win) {
                    tg.showAlert(`🎉 ПОБЕДА! Ты улучшил NFT до Дракона!`);
                    tg.sendData(JSON.stringify({ action: "upgrade", win: true }));
                } else {
                    tg.showAlert(`😔 Проигрыш... NFT сгорела.`);
                    tg.sendData(JSON.stringify({ action: "upgrade", win: false }));
                }
            }, 1000);
        }
    </script>
</body>
</html>
